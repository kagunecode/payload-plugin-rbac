{
  "name": "@crz-studio/payload-rbac",
  "version": "0.0.0-semantically-released",
  "description": "Role-based access control for Payload CMS with auto-generated CRUD permissions for every collection and global.",
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "rbac",
    "roles",
    "permissions",
    "access-control"
  ],
  "homepage": "https://github.com/crz-studio/payload-rbac#readme",
  "bugs": {
    "url": "https://github.com/crz-studio/payload-rbac/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crz-studio/payload-rbac.git"
  },
  "license": "MIT",
  "author": "CRZ Studio",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "import": "./src/exports/client.ts",
      "types": "./src/exports/client.ts",
      "default": "./src/exports/client.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist --rootDir ./src",
    "check:comments": "node scripts/check-comments.mjs",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev --turbo",
    "dev:generate-importmap": "pnpm dev:payload generate:importmap",
    "dev:generate-types": "pnpm dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "generate:importmap": "pnpm dev:generate-importmap",
    "generate:types": "pnpm dev:generate-types",
    "lint": "eslint",
    "lint:fix": "eslint ./src --fix",
    "test": "pnpm test:int && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:int": "vitest",
    "test:int:postgres": "cross-env DATABASE_ADAPTER=postgres vitest",
    "test:int:sqlite": "cross-env DATABASE_ADAPTER=sqlite vitest",
    "typecheck": "tsc --noEmit -p dev/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@payloadcms/db-mongodb": "3.90.0",
    "@payloadcms/db-postgres": "3.90.0",
    "@payloadcms/db-sqlite": "3.90.0",
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/next": "3.90.0",
    "@payloadcms/richtext-lexical": "3.90.0",
    "@payloadcms/ui": "3.90.0",
    "@playwright/test": "1.58.2",
    "@semantic-release/exec": "^7.1.0",
    "@swc-node/register": "1.10.9",
    "@swc/cli": "0.6.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "copyfiles": "2.4.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.23.0",
    "eslint-config-next": "16.3.3",
    "graphql": "^16.8.1",
    "mongodb-memory-server": "10.1.4",
    "next": "16.3.3",
    "open": "^10.1.0",
    "payload": "3.90.0",
    "prettier": "^3.4.2",
    "qs-esm": "8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rimraf": "3.0.2",
    "semantic-release": "^25.0.9",
    "sharp": "0.35.4",
    "sort-package-json": "^2.10.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.90.0",
    "payload": "^3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./client": {
        "import": "./dist/exports/client.js",
        "types": "./dist/exports/client.d.ts",
        "default": "./dist/exports/client.js"
      }
    },
    "main": "./dist/index.js",
    "provenance": true,
    "types": "./dist/index.d.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "registry": "https://registry.npmjs.org/"
}
